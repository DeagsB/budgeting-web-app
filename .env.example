# Copy to .env.local and fill in from your Supabase project dashboard
# (Project Settings → API). The anon key is safe to expose to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-only. Only set if you need to run privileged admin ops
# (bypassing RLS). Never send this to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

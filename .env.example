# Copy to .env.local and fill in from your Supabase project dashboard
# (Project Settings → API). The anon key is safe to expose to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for the email auto-import pipeline (POST /api/ingest/email).
# The webhook authenticates the caller via a per-household secret stored in
# `households.email_ingest_secret`, then uses this key to bypass RLS when
# writing the transaction. Server-only — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

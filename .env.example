# Copy to .env.local and fill in from your Supabase project dashboard
# (Project Settings → API). The anon key is safe to expose to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of this deployment, no trailing slash. Used to build the
# email-confirmation and household-invitation links. Add
# `<NEXT_PUBLIC_SITE_URL>/auth/confirm**` to Supabase Auth → URL Configuration
# → Redirect URLs, and configure custom SMTP there or invitation emails will
# only reach your Supabase team's addresses (the app always shows a copyable
# link as a fallback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the email auto-import pipeline (POST /api/ingest/email).
# The webhook authenticates the caller via a per-household secret stored in
# `households.email_ingest_secret`, then uses this key to bypass RLS when
# writing the transaction. Server-only — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Plaid (optional) — automatic, merchant-rich transaction sync ──────────
# Sign up at https://dashboard.plaid.com. Use Sandbox keys to test, then
# Production keys (free Trial tier = up to 10 linked banks) for real accounts.
# Without these, the Plaid connect screen shows a "not configured" banner and
# the email pipeline keeps working unchanged. All server-only.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
# sandbox | production. If unset, a production build assumes `production`
# (signed webhooks required, production API) so a forgotten var fails closed.
PLAID_ENV=sandbox
# Publicly-reachable URL Plaid posts transaction updates to. In dev, use a
# tunnel (e.g. ngrok) → https://<tunnel>/api/plaid/webhook. REQUIRED when
# PLAID_ENV=production; in sandbox it falls back to the request host.
PLAID_WEBHOOK_URL=
# OAuth-only banks (most major Canadian banks: RBC, TD, Scotia…) redirect the
# user back here after they authenticate on the bank's site. Must EXACTLY match
# an "Allowed redirect URI" registered in the Plaid dashboard (Developers → API).
# REQUIRED when PLAID_ENV=production. Point it at the Plaid setup page:
# https://<your-domain>/transactions/import/plaid-setup
PLAID_REDIRECT_URI=
# 32 random bytes, base64-encoded — encrypts the Plaid access token at rest.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
PLAID_TOKEN_KEY=
# Bearer secret for the scheduled GET /api/cron/daily (Plaid safety-net sweep
# + settlement auto-close). Vercel Cron sends it automatically when set on the
# project. Required on the production deployment. Generate: 32 random bytes.
CRON_SECRET=
